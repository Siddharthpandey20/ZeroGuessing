# Copy to .env and fill in. Never commit .env, and never put real secrets in this example file.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
GEMINI_FALLBACK_MODELS=gemini-3.6-flash,gemini-3.5-flash-lite
GEMINI_EMBED_MODEL=gemini-embedding-2
EMBED_DIM=768
# LLM_PROVIDER=fake   # dev only: deterministic stand-in, no key needed

DATABASE_URL=postgresql+asyncpg://zeroguess:zeroguess@localhost:5433/zeroguess
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# --- auth ---
# Service/script key (X-API-Key header); acts as admin. Use a long random value in production.
API_KEY=change-me
# Signs our JWTs. Generate: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=
ACCESS_TTL_MIN=30
REFRESH_TTL_DAYS=14
# Google sign-in: OAuth 2.0 "Web application" client ID (Google Cloud console > APIs & Services > Credentials)
GOOGLE_CLIENT_ID=
# These emails become admin on sign-in (comma-separated). Everyone else is a viewer.
ADMIN_EMAILS=
# Restrict Google sign-in to these email domains (comma-separated). Empty = any verified Google account.
ALLOWED_EMAIL_DOMAINS=
ALLOW_PASSWORD_LOGIN=true
# Optional first admin for email/password login (created on startup if missing)
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
# Production (HTTPS): COOKIE_SECURE=true. If the frontend and API are on different sites: COOKIE_SAMESITE=none
COOKIE_SECURE=false
COOKIE_SAMESITE=lax

STORAGE_BACKEND=local   # local | s3 | gcs  (production: see docs/DEPLOY.md)
STORAGE_DIR=./data/files
GCS_BUCKET=
# S3 / S3-compatible (STORAGE_BACKEND=s3); credentials via AWS_ACCESS_KEY_ID / AWS_SECRET_ACCESS_KEY
S3_BUCKET=
S3_REGION=
S3_ENDPOINT_URL=

# Tamper-proof reports: base64 of a 32-byte Ed25519 seed (python -c "import os,base64;print(base64.b64encode(os.urandom(32)).decode())").
# Empty = derived from JWT_SECRET. Keep it stable: reports signed with a lost key can no longer be verified.
REPORT_SIGNING_KEY=
# Public address, printed in offline report copies as the verify link (e.g. https://zeroguess.example)
PUBLIC_ORIGIN=
